    <CheatEntry>
      <ID>9000</ID>
      <Description>"HotA skill-order probe (read-only; signature scan)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Based on CannonFodder's HotA table probe; scan the target bytes in the loaded HotA module. }
define(bytes,8A 04 01 88 46 08)
[ENABLE]
aobscanmodule(skillOrderHook,hota.dll,8A 04 01 88 46 08)
registersymbol(skillOrderHook)
alloc(newmem,$1000)
label(skillOrderAddr)
registersymbol(skillOrderAddr)
label(return)
newmem:
  mov [skillOrderAddr],ecx
  mov al,[ecx+eax]
  mov [esi+08],al
  jmp return
skillOrderAddr:
  dd 0
skillOrderHook:
  jmp newmem
  nop
return:
[DISABLE]
skillOrderHook:
  db bytes
unregistersymbol(skillOrderAddr)
unregistersymbol(skillOrderHook)
dealloc(newmem)</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9001</ID>
      <Description>"Battle: infinite spell cast hook (UI toggle controls it)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Adapted from CannonFodder's HotA Get Combat Magic Cast injection. }
define(bytes,C7 84 8B B4 54 00 00 01 00 00 00)
[ENABLE]
aobscanmodule(infiniteSpellCastHook,h3hota HD.exe,C7 84 8B B4 54 00 00 01 00 00 00)
registersymbol(infiniteSpellCastHook)
assert(infiniteSpellCastHook,bytes)
alloc(newmem,$1000,infiniteSpellCastHook)
label(combatMagicCastSwitchAddr)
registersymbol(combatMagicCastSwitchAddr)
label(bSpellCastPending)
registersymbol(bSpellCastPending)
label(return)
newmem:
  mov [combatMagicCastSwitchAddr],ebx
  add [combatMagicCastSwitchAddr],ecx
  add [combatMagicCastSwitchAddr],ecx
  add [combatMagicCastSwitchAddr],ecx
  add [combatMagicCastSwitchAddr],ecx
  mov dword ptr [bSpellCastPending],1
  mov dword ptr [ebx+ecx*4+000054B4],00000001
  jmp return
combatMagicCastSwitchAddr:
  dd 0
bSpellCastPending:
  dd 0
infiniteSpellCastHook:
  jmp newmem
  nop 6
return:
[DISABLE]
infiniteSpellCastHook:
  db bytes
unregistersymbol(combatMagicCastSwitchAddr)
unregistersymbol(bSpellCastPending)
unregistersymbol(infiniteSpellCastHook)
dealloc(newmem)</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9003</ID>
      <Description>"Neutral creature pointer capture (enable before right-clicking)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Adapted from the HotA neutral-creature status probe in the reference table. }
define(bytes,8B 04 88 89 47 18)
[ENABLE]
aobscanmodule(neutralCreatureReadHook,hota.dll,8B 04 88 89 47 18)
registersymbol(neutralCreatureReadHook)
assert(neutralCreatureReadHook,bytes)
alloc(newmem,$1000,neutralCreatureReadHook)
label(neutralCreatureRecordAddr)
registersymbol(neutralCreatureRecordAddr)
label(neutralCreatureCaptureCount)
registersymbol(neutralCreatureCaptureCount)
label(return)
newmem:
  push edx
  lea edx,[eax+ecx*4]
  mov [neutralCreatureRecordAddr],edx
  pop edx
  inc dword ptr [neutralCreatureCaptureCount]
  mov eax,[eax+ecx*4]
  mov [edi+18],eax
  jmp return
neutralCreatureRecordAddr:
  dd 0
neutralCreatureCaptureCount:
  dd 0
neutralCreatureReadHook:
  jmp newmem
  nop
return:
[DISABLE]
neutralCreatureReadHook:
  db bytes
unregistersymbol(neutralCreatureReadHook)
unregistersymbol(neutralCreatureRecordAddr)
unregistersymbol(neutralCreatureCaptureCount)
dealloc(newmem)</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9004</ID>
      <Description>"Hero specialty table pointer probe"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Reads the specialty-table pointer immediate used by the reference HotA table. }
[ENABLE]
aobscanmodule(specialtyTablePointerPattern,h3hota HD.exe,8B 15 ?? ?? ?? ?? 8D 0C 80 8D 04 CA)
registersymbol(specialtyTablePointerPattern)
alloc(newmem,$1000,specialtyTablePointerPattern)
label(Specialties)
registersymbol(Specialties)
newmem:
Specialties:
  readmem(specialtyTablePointerPattern+2,4)
[DISABLE]
unregistersymbol(specialtyTablePointerPattern)
unregistersymbol(Specialties)
dealloc(newmem)</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9005</ID>
      <Description>"Reveal Puzzle Map (adapted from HoMM3 2.0 HD.ct)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{Patch the puzzle-piece lookup so the puzzle map is fully revealed.}
define(bytes,0F BE 84 30 04 CB 00 00)
[ENABLE]
aobscanmodule(puzzleReveal,h3hota HD.exe,0F BE 84 30 04 CB 00 00)
registersymbol(puzzleReveal)
assert(puzzleReveal,bytes)
puzzleReveal:
  mov eax,30
  nop 3
[DISABLE]
puzzleReveal:
  db bytes
unregistersymbol(puzzleReveal)</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
