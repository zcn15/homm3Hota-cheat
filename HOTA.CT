<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>255</ID>
      <Description>"HMM3 HD 5 RC94 + HOTA 1.6.1 AOB script"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Game Executable   : h3hota HD.exe
// Author            : Cs
// Executable Version: 3.2.0.0
// Module Version    : 
// Script Date       : 2020-08-24
// Created with      : customAOBInjectionTemplates version: 1.3.6
[ENABLE]
aobscanmodule(aobPlayerGrabber,h3hota HD.exe,8A 81 ?? ?? 00 00 84 C0 74 ?? B0 01)
aobscanmodule(aobHeroMovePtsOffset,h3hota HD.exe,89 47 ?? 89 47 ?? A1 ?? ?? ?? ?? 46)
aobscanmodule(aobHeroPtrMath,h3hota HD.exe,A1 ?? ?? ?? ?? 8B 48 ?? 83 F9 ?? 0F 84 ?? ?? 00 00 8B C1 C1 E0 ?? 03 C1 8B 0D ?? ?? ?? ?? 8D 04 C0 8D 9C 41 ?? ?? ?? ?? 85)
aobscanmodule(aobStackLossCalc,h3hota HD.exe,8B 9E ?? ?? 00 00 03 C8 8B C1 99 F7 FB)
aobscanmodule(aobStackSideOffset,h3hota HD.exe,8B 86 ?? ?? 00 00 3B C1 0F 84 ?? ?? 00 00 8B 46)
aobscanmodule(aobHasBuiltThisTurn,h3hota HD.exe,8A 51 ?? 84 D2 74 ?? 40)

alloc(newmemPlayerGrabber,4096,aobPlayerGrabber)

label(aobPlayerGrabber_r)
label(aobPlayerGrabber_i)
registersymbol(aobPlayerGrabber_r)
registersymbol(aobPlayerGrabber_i)

label(lblPlayerGrabber)
label(lblPlayerGrabberSkip)
label(lblPlayerGrabberRet)

label(pEnableInfiniteMovementPts)
registersymbol(pEnableInfiniteMovementPts)

label(pPlayer)
label(pPlayerCurrentHero)
registersymbol(pPlayer)
registersymbol(pPlayerCurrentHero)

label(iHeroMovePtsOffsets)
registersymbol(iHeroMovePtsOffsets)

label(aobStackLossCalc_r)
label(aobStackLossCalc_i)
registersymbol(aobStackLossCalc_r)
registersymbol(aobStackLossCalc_i)

label(lblStackLossCalc)
label(lblStackLossCalcSkip)
label(lblStackLossCalcRet)

label(bEnableGodMode)
registersymbol(bEnableGodMode)

label(iStackSideOffset)
registersymbol(iStackSideOffset)

label(aobHasBuiltThisTurn_r)
label(aobHasBuiltThisTurn_i)
registersymbol(aobHasBuiltThisTurn_r)
registersymbol(aobHasBuiltThisTurn_i)

label(lblHasBuiltThisTurn)
label(lblHasBuiltThisTurnSkip)
label(lblHasBuiltThisTurnRet)

label(bEnableInfiniteBuild)
registersymbol(bEnableInfiniteBuild)

newmemPlayerGrabber:
bEnableGodMode:
dd 1
pEnableInfiniteMovementPts:
dd 1
bEnableInfiniteBuild:
dd 1

lblPlayerGrabber:
pushad
readmem(aobPlayerGrabber,6)
test al,al
jz short lblPlayerGrabberSkip
mov dword ptr [pPlayer],ecx
reassemble(aobHeroPtrMath)
reassemble(aobHeroPtrMath+5)
reassemble(aobHeroPtrMath+8)
je short lblPlayerGrabberSkip
reassemble(aobHeroPtrMath+11)
reassemble(aobHeroPtrMath+13)
reassemble(aobHeroPtrMath+16)
reassemble(aobHeroPtrMath+18)
reassemble(aobHeroPtrMath+1E)
reassemble(aobHeroPtrMath+21)
reassemble(aobHeroPtrMath+28)
je short lblPlayerGrabberSkip
mov dword ptr [pPlayerCurrentHero],ebx
cmp dword ptr [pEnableInfiniteMovementPts],1
jne short lblPlayerGrabberSkip
mov eax,[iHeroMovePtsOffsets+04]
mov ecx,[eax+ebx]
mov eax,[iHeroMovePtsOffsets]
mov [eax+ebx],ecx
lblPlayerGrabberSkip:
popad
readmem(aobPlayerGrabber,6)
jmp lblPlayerGrabberRet
aobPlayerGrabber_i:
readmem(aobPlayerGrabber,6)
pPlayer:
dd 0
pPlayerCurrentHero:
dd 0
iHeroMovePtsOffsets:
readmem(aobHeroMovePtsOffset+02,1)
db 00 00 00
readmem(aobHeroMovePtsOffset+05,1)
dd 0

lblStackLossCalc:
mov ebx,[iStackSideOffset]
cmp dword ptr [esi+ebx],0
jne short lblStackLossCalcSkip
cmp dword ptr [bEnableGodMode],1
jne short lblStackLossCalcSkip
xor eax,eax
xor ecx,ecx
lblStackLossCalcSkip:
readmem(aobStackLossCalc,6)
jmp lblStackLossCalcRet
aobStackLossCalc_i:
readmem(aobStackLossCalc,6)
iStackSideOffset:
readmem(aobStackSideOffset+02,4)

lblHasBuiltThisTurn:
cmp dword ptr [bEnableInfiniteBuild],1
jne short lblHasBuiltThisTurnSkip
pushad
push 11
call GetAsyncKeyState
shr ax,#15
cmp ax,1
popad
jne short lblHasBuiltThisTurnSkip
mov byte ptr [ecx+02],0
lblHasBuiltThisTurnSkip:
readmem(aobHasBuiltThisTurn,5)
jmp lblHasBuiltThisTurnRet
aobHasBuiltThisTurn_i:
readmem(aobHasBuiltThisTurn,5)

aobHasBuiltThisTurn:
aobHasBuiltThisTurn_r:
jmp lblHasBuiltThisTurn
lblHasBuiltThisTurnRet:

aobStackLossCalc:
aobStackLossCalc_r:
jmp lblStackLossCalc
nop
lblStackLossCalcRet:

aobPlayerGrabber:
aobPlayerGrabber_r:
jmp lblPlayerGrabber
nop
lblPlayerGrabberRet:

[DISABLE]
aobPlayerGrabber_r:
readmem(aobPlayerGrabber_i,6)

unregistersymbol(aobPlayerGrabber_r)
unregistersymbol(aobPlayerGrabber_i)

unregistersymbol(pEnableInfiniteMovementPts)

unregistersymbol(pPlayer)
unregistersymbol(pPlayerCurrentHero)

unregistersymbol(iHeroMovePtsOffsets)

aobStackLossCalc_r:
readmem(aobStackLossCalc_i,6)

unregistersymbol(aobStackLossCalc_r)
unregistersymbol(aobStackLossCalc_i)

unregistersymbol(bEnableGodMode)

unregistersymbol(iStackSideOffset)

aobHasBuiltThisTurn_r:
readmem(aobHasBuiltThisTurn_i,5)

unregistersymbol(aobHasBuiltThisTurn_r)
unregistersymbol(aobHasBuiltThisTurn_i)

unregistersymbol(bEnableInfiniteBuild)

dealloc(newmemPlayerGrabber)

</AssemblerScript>
