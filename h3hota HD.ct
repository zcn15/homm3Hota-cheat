          <AssemblerScript>{ Game   : h3hota.exe
  Version: 
  Date   : 2023-05-04
  Author : CannonFodder

  This script does blah blah blah
}

define(address,"hota.dll"+1232A4)
define(bytes,8A 04 01 88 46 08)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000)

label(skillOrderAddr)
registersymbol(skillOrderAddr)

label(code)
label(return)

newmem:
  mov [skillOrderAddr], ecx
code:
  mov al,[ecx+eax]
  mov [esi+08],al
  jmp return

skillOrderAddr:
  dd 0

address:
  jmp newmem
  nop
return:

[DISABLE]

address:
  db bytes
  // mov al,[ecx+eax]
  // mov [esi+08],al

unregistersymbol(skillOrderAddr)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: hota.dll+E5EA4

hota.dll+E5E8D: CC              - int 3 
hota.dll+E5E8E: CC              - int 3 
hota.dll+E5E8F: CC              - int 3 
hota.dll+E5E90: 56              - push esi
hota.dll+E5E91: 8B 74 24 0C     - mov esi,[esp+0C]
hota.dll+E5E95: FF 36           - push [esi]
hota.dll+E5E97: E8 E4 3E F7 FF  - call hota.dll+59D80
hota.dll+E5E9C: 8B 00           - mov eax,[eax]
hota.dll+E5E9E: 8B 48 08        - mov ecx,[eax+08]
hota.dll+E5EA1: 8B 46 18        - mov eax,[esi+18]
// ---------- INJECTING HERE ----------
hota.dll+E5EA4: 8A 04 01        - mov al,[ecx+eax]
// ---------- DONE INJECTING  ----------
hota.dll+E5EA7: 88 46 08        - mov [esi+08],al
hota.dll+E5EAA: 33 C0           - xor eax,eax
hota.dll+E5EAC: 5E              - pop esi
hota.dll+E5EAD: C2 08 00        - ret 0008
hota.dll+E5EB0: 56              - push esi
hota.dll+E5EB1: 8B 74 24 0C     - mov esi,[esp+0C]
hota.dll+E5EB5: FF 76 04        - push [esi+04]
hota.dll+E5EB8: E8 C3 3E F7 FF  - call hota.dll+59D80
hota.dll+E5EBD: 8B 56 18        - mov edx,[esi+18]
hota.dll+E5EC0: 8B 00           - mov eax,[eax]
}
</AssemblerScript>
