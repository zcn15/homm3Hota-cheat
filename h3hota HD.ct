</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>488</ID>
          <Description>"Item Selector Bak"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
-- Create main form
local ceMainForm = getMainForm()
local frmMain = createForm(ceMainForm)
frmMain.Caption = 'Item List Filter'
frmMain.Width = 500
frmMain.Height = 400
frmMain.Position = 'poOwnerFormCenter'
--print(ceMainForm.Left)
--print(ceMainForm.Top)

-- Create label
local lblFilter = createLabel(frmMain)
lblFilter.Caption = 'Filter:'
lblFilter.Left = 20
lblFilter.Top = 20

-- Create filter input box
local edtFilter = createEdit(frmMain)
edtFilter.Left = 80
edtFilter.Top = 18
edtFilter.Width = 200
edtFilter.Text = ''
edtFilter.Hint = 'Enter keywords for real-time filtering'
edtFilter.ShowHint = true

-- Create clear filter button
local btnClear = createButton(frmMain)
btnClear.Caption = 'Clear'
btnClear.Left = 290
btnClear.Top = 18
btnClear.Width = 60

-- Create status label
local lblStatus = createLabel(frmMain)
lblStatus.Caption = 'Total 0 items'
lblStatus.Left = 360
lblStatus.Top = 22
lblStatus.Font.Style = '[]' -- Normal font

-- Create ListBox
local lbItems = createListBox(frmMain)
lbItems.Left = 20
lbItems.Top = 50
lbItems.Width = 460
lbItems.Height = 300
lbItems.MultiSelect = false

-- 函数：从 iItemList record 的 DropDownValue 和 DropDownDescription 中提取物品数据
function getItemDataFromDropdown()
    local itemData = {}

    -- 查找 iItemList record
    local addressList = getAddressList()
    local iItemListRecord = nil

    -- 遍历地址列表查找 iItemList
    for i = 0, addressList.Count - 1 do
        local record = addressList[i]
        if record.Description == "iItemList" then
            iItemListRecord = record
            break
        end
    end

    if iItemListRecord == nil then
        print("Error: iItemList record not found in address list")
        return itemData
    end

    -- 检查是否有 DropDown 数据
    if iItemListRecord.DropDownCount == nil or iItemListRecord.DropDownCount == 0 then
        print("Error: No dropdown data found in iItemList record")
        return itemData
    end

    -- 直接使用 DropDownValue 和 DropDownDescription 访问数据
    local dropDownCount = iItemListRecord.DropDownCount
    for i = 0, dropDownCount - 1 do
        local value = iItemListRecord.DropDownValue[i]
        local description = iItemListRecord.DropDownDescription[i]

        if value ~= nil and description ~= nil then
            itemData[tostring(value)] = description
        end
    end

    --print("Loaded " .. dropDownCount .. " items from iItemList dropdown")
    return itemData
end

-- 函数：获取物品数据（不使用备用数据）
function getItemData()
    return getItemDataFromDropdown()
end

-- Helper function: Convert ID to number for sorting
function idToNumber(id)
    -- Handle special large value ID
    --if id == "4294967295" then
    --    return -1
    --end
    return tonumber(id) or 0
end

-- Initialize list (sort by ID)
function initializeList()
    lbItems.Items.clear()
    allItems = {} -- Clear and refill
    local itemData = getItemData()
    -- Convert data to list item format
    local tempItems = {}
    for id, name in pairs(itemData) do
        local item = {
            id = id,
            name = name,
            display = string.format("[%s] %s", id, name),
            numericId = idToNumber(id)
        }
        table.insert(tempItems, item)
    end

    -- Sort by numeric ID
    table.sort(tempItems, function(a, b)
        return a.numericId &lt; b.numericId
    end)

    -- Add sorted items to list
    for _, item in ipairs(tempItems) do
        table.insert(allItems, item)
        lbItems.Items.add(item.display)
    end

    updateStatus()
end

-- Filter list function
function filterList(filterText)
    lbItems.Items.clear()

    local filterLower = string.lower(filterText)
    local matchCount = 0

    for _, item in ipairs(allItems) do
        local displayLower = string.lower(item.display)
        local nameLower = string.lower(item.name)
        local idLower = string.lower(item.id)

        -- Check if matches display text, name, or ID
        if string.find(displayLower, filterLower, 1, true) or
           string.find(nameLower, filterLower, 1, true) or
           string.find(idLower, filterLower, 1, true) then
            lbItems.Items.add(item.display)
            matchCount = matchCount + 1
        end
    end

    updateStatus(matchCount)
end

-- Update status label
function updateStatus(matchCount)
    local totalCount = #allItems
    matchCount = matchCount or totalCount

    if matchCount == totalCount then
        lblStatus.Caption = string.format("Total %d items", totalCount)
        lblStatus.Font.Color = 0x000000 -- Black
    else
        lblStatus.Caption = string.format("Showing %d / %d items", matchCount, totalCount)
        lblStatus.Font.Color = 0xFF0000 -- Red
    end
end

-- Get current selected item information
function getSelectedItemInfo()
    local selectedIndex = lbItems.ItemIndex
    if selectedIndex &gt;= 0 then
        local selectedText = lbItems.Items[selectedIndex]
        -- Extract ID and name from display text
        local id, name = string.match(selectedText, "%[(%d+)%] (.+)")
        if id and name then
            return {id = id, name = name}
        end
    end
    return nil
end

-- Create selected item information display area
local lblSelected = createLabel(frmMain)
lblSelected.Caption = 'Selected: None'
lblSelected.Left = 20
lblSelected.Top = 355
lblSelected.Width = 460
lblSelected.Height = 20

-- Event handler functions

-- Filter input box text change event
edtFilter.OnChange = function()
    filterList(edtFilter.Text)
end

-- Clear filter button click event
btnClear.OnClick = function()
    edtFilter.Text = ''
    filterList('')
    edtFilter.SetFocus()
end

-- ListBox selection change event
lbItems.OnSelectionChange = function()
    local selected = getSelectedItemInfo()
    if selected then
        lblSelected.Caption = string.format("Selected: ID=%s, Name=%s", selected.id, selected.name)
    else
        lblSelected.Caption = 'Selected: None'
    end
end

function applyValue(selected)
    -- *** ADAPTATION POINT 1: Retrieve the currently selected memory record ***
    -- This assumes the user has clicked on the record they want to change in the Address List.
    local addressList = getAddressList()
    local targetRecord = addressList.SelectedRecord -- Get the currently highlighted record

    if not targetRecord then
        showMessage("ERROR: No item memory record is selected in the Cheat Table.")
        return
    end

    local valueToApply = nil

    --print(targetRecord.Type)
    --print(targetRecord.Description)
    if selected
       and targetRecord.Type == 2 --4 Bytes
       and string.sub(targetRecord.Description, 1, 6) == "iItem["
    then
        valueToApply = selected.id
        -- *** ADAPTATION POINT 2: Write the value to memory ***
        -- Note: Ensure the target record's Value Type is compatible (e.g., 4 Bytes)
        targetRecord.Value = valueToApply

        -- Update the Cheat Table display immediately
        addressList.refresh()
    end
end

-- Optional: Add double-click ListBox item event
lbItems.OnDblClick = function()
    local selected = getSelectedItemInfo()
    if selected then
        --showMessage(string.format("You double-clicked: %s (ID: %s)", selected.name, selected.id))
        applyValue(selected)
    end
end

AddressList.OnValueChange=function(addresslist,memrec)
  --print(memrec.Type)
  --print(memrec.Description)
  if memrec.Type == 2 --4 Bytes
    and string.sub(memrec.Description, 1, 6) == "iItem["
  then
    frmMain.Show()
    return true
  else
    return false
  end
end

-- Initialize list
initializeList()

-- Show form
frmMain.Show()

