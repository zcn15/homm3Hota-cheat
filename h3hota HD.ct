  add [combatMagicCastSwitchAddr],ecx
  add [combatMagicCastSwitchAddr],ecx
  add [combatMagicCastSwitchAddr],ecx
  add [combatMagicCastSwitchAddr],ecx
code:
  mov [ebx+ecx*4+000054B4],00000001
  jmp return

combatMagicCastSwitchAddr:
  dd 0

AfterCombatMagicCastInject:
  jmp newmem
  nop 6
return:
registersymbol(AfterCombatMagicCastInject)

[DISABLE]

AfterCombatMagicCastInject:
  db C7 84 8B B4 54 00 00 01 00 00 00

unregistersymbol(combatMagicCastSwitchAddr)
unregistersymbol(AfterCombatMagicCastInject)
dealloc(newmem)

