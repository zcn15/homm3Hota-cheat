[ENABLE]

aobscanmodule(HeroLevelWriteInject,h3hota HD.exe,66 89 53 55 8B 4D F4) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  cmp dx,4A  //level cap 74
  jne code
  mov dx,7FFE //set level to 32766 if it's 74
code:
  mov [ebx+55],dx
  mov ecx,[ebp-0C]
  jmp return

HeroLevelWriteInject:
  jmp newmem
  nop 2
return:
registersymbol(HeroLevelWriteInject)

[DISABLE]

