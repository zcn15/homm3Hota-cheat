aobscanmodule(casticon,$process,0F B7 46 16 A8 02 0F)
alloc(castmem,56)
label(AsAttacker,castret,icomem,icocode,icoret)
registersymbol(cast,casticon)

castmem:
  push eax
  mov eax,[ebx+12624]
  cmp [[MyTurn]],0
  je AsAttacker
  test eax,eax
  sete al
AsAttacker:
  mov [ebx+ecx*4+54A0],eax
  pop eax
  jmp castret
icomem:
  mov word ptr [esi+16],6
icocode:
  movzx eax,word ptr [esi+16]
  test al,2
  jmp icoret
cast:
  jmp castmem
  nop 6
castret:
casticon:
  jmp icomem
  nop
icoret:

