          <Description>"Next Level XP   [Alt+X]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(nextxp,$process,A1 * * * * 0F BF 70 51 FF 70 4D 8D 4E 01)
alloc(newmem,32)
label(code,return)
registersymbol(nextxp)

newmem:
  push eax
  lea ecx,[esi+1]
  reassemble(nextxp+F)
  mov ecx,eax
  pop eax
  dec ecx
  mov [eax+4D],ecx
code:
  push [eax+4D]
  lea ecx,[esi+1]
  jmp return
nextxp+9:
  jmp newmem
  nop
return:

[DISABLE]
nextxp+9:
  db FF 70 4D 8D 4E 01
unregistersymbol(nextxp)
dealloc(newmem)

