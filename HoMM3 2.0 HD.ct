[EN ABLE]
aobscanmodule(wanderovr,$process,B8 00 10 00 00 66 85 46 10 0F 84 * * * * 0F BF 46 22)
aobscanmodule(wanderclk,$process,0F BF 48 22 8B 00)
alloc(ovrmem,104)
label(ovrcode,ovrret,clkmem,clkcode,clkret,MonsAdrs,MonsCount,Disposition)
registersymbol(wanderovr,wanderclk,MonsCount,Disposition)

ovrmem:
  cmp [MonsAdrs],esi
  je ovrcode
  mov [MonsAdrs],esi
  mov eax,[esi]
  and eax,00000FFF
  mov [MonsCount],eax
  mov eax,[esi]
  shr eax,C
  mov [Disposition],al
ovrcode:
  mov eax,1000
  jmp ovrret
clkmem:
  cmp [MonsAdrs],eax
  jne clkcode
  mov ecx,[MonsCount]
  mov [eax],ecx
  movzx ecx,byte ptr [Disposition]
  shl ecx,C
  or [eax],ecx
clkcode:
  movsx ecx,word ptr [eax+22]
  mov eax,[eax]
  jmp clkret
MonsAdrs:
  dd 0
MonsCount:
  dd 0
Disposition:
  db 2A
wanderovr:
  jmp ovrmem
ovrret:
wanderclk:
  jmp clkmem
  nop
clkret:

[DIS ABLE]
wanderovr:
  db B8 00 10 00 00
wanderclk:
  db 0F BF 48 22 8B 00
unregistersymbol(wanderovr,wanderclk,MonsCount,Disposition)
dealloc(ovrmem)
}
