          <AssemblerScript>[ENABLE]
aobscanmodule(wander,$process,B8 00 10 00 00 66 85 46 10 0F 84 * * * * 0F BF 46 22)
alloc(newmem,24)
label(code,return,MonsAdrs)
registersymbol(wander,MonsAdrs)

newmem:
  mov [MonsAdrs],esi
code:
  mov eax,1000
  jmp return
MonsAdrs:
  dd 0
wander:
  jmp newmem
return:

[DISABLE]
wander:
  db B8 00 10 00 00
unregistersymbol(wander,MonsAdrs)
dealloc(newmem)

