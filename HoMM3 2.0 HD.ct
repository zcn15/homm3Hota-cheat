  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"HoMM 3 HD 2.0"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(char,$process,0F BF 01 89 44 24 50)
aobscanmodule(townmap,$process,8B 82 6C 01 00 00 23 0D * * * * 23 05 * * * * 0B C8 74 * 0F)
aobscanmodule(townlist,$process,0F BE 41 04 83  E8 00)
aobscanmodule(game,$process,A1 * * * * 85 C0 74 * 80 B8 DA 00 00 00 00 74)
aobscanmodule(turn,$process,A3 * * * * 74 * 8B CF E8 * * * * 83)
aobscanmodule(specs,$process,83 3C 8D * * * * 01)
alloc(chrmem,72)
label(return,Base,Hero,mapmem,mapret,listmem,listret,Town,MyTurn,Specialties)
registersymbol(char,townmap,townlist,Base,Hero,Town,MyTurn,Specialties)

chrmem:
  mov [Hero],ecx
  movsx eax,word ptr [ecx]
  mov [esp+50],eax
  jmp return
mapmem:
  mov [Town],edx
  mov eax,[edx+16C]
  jmp mapret
listmem:
  mov [Town],ecx
  movsx eax,byte ptr [ecx+4]
  sub eax,0
  jmp listret
Base:
  readmem(game+1,4)
MyTurn:
  readmem(turn+1,4)
Specialties:
  readmem(specs+3,4)
Hero:
  dd 0
Town:
  dd 0
char:
  jmp chrmem
  nop 2
return:
townmap:
  jmp mapmem
  nop
mapret:
townlist:
  jmp listmem
  nop 2
listret:

[DISABLE]
char:
  db 0F BF 01 89 44 24 50
townmap:
  db 8B 82 6C 01 00 00
townlist:
  db 0F BE 41 04 83  E8 00
unregistersymbol(char,townmap,townlist,Base,Hero,Town,MyTurn,Specialties)
dealloc(chrmem)

LuaCall(for i=adrs.Count-1,1,-1 do adrs[i].Active = false end)

