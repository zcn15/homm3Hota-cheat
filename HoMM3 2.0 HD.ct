aobscanmodule(infimana,$process,2B 45 08 8D 55 08)
aobscanmodule(minmana,$process,3B C1 7F * 8B 4C)
alloc(newmem,40)
label(code,return)
registersymbol(infimana,minmana)

newmem:
  push eax
  mov eax,[ebx+12624]
  cmp [[MyTurn]],eax
  pop eax
  jne code
  mov [ebp+08],0
code:
  sub eax,[ebp+08]
  lea edx,[ebp+08]
  jmp return
infimana:
  jmp newmem
  nop
return:
minmana:
  cmp eax,eax

